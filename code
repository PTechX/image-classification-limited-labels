        "id": "pmDo3sznRyvi"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import random\n",
        "\n",
        "random.seed(42)\n",
        "\n",
        "train_data = dataset[\"train\"]\n",
        "validation_data = dataset[\"validation\"]\n",
        "test_data = dataset[\"test\"]\n",
        "\n",
        "class_names = dataset[\"train\"].features[\"labels\"].names\n",
        "\n",
        "print(\"Classes:\", class_names)\n",
        "\n",
        "# Select only 20 images from each class\n",
        "selected_indices = []\n",
        "\n",
        "for class_id in range(len(class_names)):\n",
        "    class_indices = [\n",
        "        i for i, label in enumerate(train_data[\"labels\"])\n",
        "        if label == class_id\n",
        "    ]\n",
        "\n",
        "    selected_indices.extend(\n",
        "        random.sample(class_indices, 20)\n",
        "    )\n",
        "\n",
        "limited_train_data = train_data.select(selected_indices)\n",
        "\n",
        "print(\"Total labelled training images:\", len(limited_train_data))\n",
        "\n",
        "for class_id, name in enumerate(class_names):\n",
        "    count = sum(\n",
        "        1 for label in limited_train_data[\"labels\"]\n",
        "        if label == class_id\n",
        "    )\n",
        "    print(name, \":\", count, \"images\")"
      ],
